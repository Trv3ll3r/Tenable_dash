# Tenable API Credentials (REQUIRED)
TENABLE_ACCESS_KEY=
TENABLE_SECRET_KEY=

# Ermetic API Configuration (if using Ermetic endpoint)
ERMETIC_API_URL=https://us.app.ermetic.com/api/graph
ERMETIC_API_TOKEN=

# Optional Tenable Services
TENABLE_CS_API_KEY=
TENABLE_CS_URL=https://cloud.tenable.com

# Flask Application Settings
SECRET_KEY=
FLASK_DEBUG=False

# Database Configuration
DATABASE_DIR=./data

# Application Settings
DEFAULT_DAYS_SINCE=30
HOST=127.0.0.1
PORT=5000

# GRC Compliance Mapping
GRC_JSON_PATH=./data/grc_mappings.json

# Logging
LOG_LEVEL=INFO
LOG_FILE=./data/tenable_dashboard.log

# Feature Flags (true/false)
ENABLE_ATTACK_PATH_ANALYSIS=true
ENABLE_WAS_FINDINGS=true
ENABLE_GRC_MAPPING=true
ENABLE_CLOUD_METADATA=true
ENABLE_EXPOSURE_SCORING=true
ENABLE_CONTAINER_SECURITY=false