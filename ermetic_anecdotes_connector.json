openapi: 3.0.3

info:
  title: Ermetic (Tenable Cloud Security) API
  description: >
    GraphQL API for Tenable Cloud Security (formerly Ermetic).
    All requests are POST to a single GraphQL endpoint using Bearer token auth.
    This spec covers Findings (CSPM) and IAM/Identity findings for use as an
    Anecdotes custom connector.
  version: "1.0"
  contact:
    name: Tenable Cloud Security
    url: https://us.app.ermetic.com/docs/api/index

servers:
  - url: https://{tenant}.app.ermetic.com
    description: Ermetic tenant endpoint
    variables:
      tenant:
        default: your-tenant
        description: Your Ermetic tenant subdomain

security:
  - BearerAuth: []

paths:

  /api/graphql:
    post:
      summary: GraphQL endpoint
      description: >
        Single endpoint for all Ermetic GraphQL queries.
        Select the request body example that matches the data you want to pull.
      operationId: graphqlQuery
      tags:
        - GraphQL
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/GraphQLRequest'
            examples:

              all_open_findings:
                summary: All open findings (paginated)
                value:
                  query: |
                    query GetFindings($first: Int!, $after: String) {
                      Findings(
                        first: $first
                        after: $after
                        filter: { Statuses: [Open] }
                      ) {
                        totalCount
                        nodes {
                          Id
                          CreationTime
                          Status
                          Severity
                          Policy {
                            Name
                            Description
                            Category
                          }
                          Resources {
                            ... on AwsResource {
                              Name
                              Arn
                              Region
                              AccountId
                              __typename
                            }
                            ... on AzureResource {
                              Name
                              Id
                              Region
                              AccountId
                              __typename
                            }
                            ... on GcpResource {
                              Name
                              Id
                              Region
                              AccountId
                              __typename
                            }
                          }
                          Remediation {
                            Console {
                              Steps
                            }
                          }
                        }
                        pageInfo {
                          hasNextPage
                          endCursor
                        }
                      }
                    }
                  variables:
                    first: 100
                    after: null

              critical_high_findings:
                summary: Critical and High severity open findings
                value:
                  query: |
                    query GetCriticalFindings($first: Int!, $after: String) {
                      Findings(
                        first: $first
                        after: $after
                        filter: {
                          Statuses: [Open]
                          Severities: [Critical, High]
                        }
                      ) {
                        totalCount
                        nodes {
                          Id
                          CreationTime
                          Status
                          Severity
                          Policy {
                            Name
                            Description
                            Category
                          }
                          Resources {
                            ... on AwsResource {
                              Name
                              Arn
                              Region
                              AccountId
                              __typename
                            }
                            ... on AzureResource {
                              Name
                              Id
                              Region
                              AccountId
                              __typename
                            }
                            ... on GcpResource {
                              Name
                              Id
                              Region
                              AccountId
                              __typename
                            }
                          }
                          Remediation {
                            Console {
                              Steps
                            }
                          }
                        }
                        pageInfo {
                          hasNextPage
                          endCursor
                        }
                      }
                    }
                  variables:
                    first: 100
                    after: null

              iam_identity_findings:
                summary: IAM / Identity findings (excessive permissions, unused roles, privilege escalation)
                value:
                  query: |
                    query GetIAMFindings($first: Int!, $after: String) {
                      Findings(
                        first: $first
                        after: $after
                        filter: {
                          Statuses: [Open]
                          Categories: [Identity]
                        }
                      ) {
                        totalCount
                        nodes {
                          Id
                          CreationTime
                          Status
                          Severity
                          Policy {
                            Name
                            Description
                            Category
                          }
                          Resources {
                            ... on AwsResource {
                              Name
                              Arn
                              Region
                              AccountId
                              __typename
                            }
                            ... on AzureResource {
                              Name
                              Id
                              Region
                              AccountId
                              __typename
                            }
                            ... on GcpResource {
                              Name
                              Id
                              Region
                              AccountId
                              __typename
                            }
                          }
                          Remediation {
                            Console {
                              Steps
                            }
                          }
                        }
                        pageInfo {
                          hasNextPage
                          endCursor
                        }
                      }
                    }
                  variables:
                    first: 100
                    after: null

              iam_critical_high:
                summary: Critical and High IAM / Identity findings only
                value:
                  query: |
                    query GetIAMCritical($first: Int!, $after: String) {
                      Findings(
                        first: $first
                        after: $after
                        filter: {
                          Statuses: [Open]
                          Severities: [Critical, High]
                          Categories: [Identity]
                        }
                      ) {
                        totalCount
                        nodes {
                          Id
                          CreationTime
                          Status
                          Severity
                          Policy {
                            Name
                            Description
                            Category
                          }
                          Resources {
                            ... on AwsResource {
                              Name
                              Arn
                              Region
                              AccountId
                              __typename
                            }
                            ... on AzureResource {
                              Name
                              Id
                              Region
                              AccountId
                              __typename
                            }
                            ... on GcpResource {
                              Name
                              Id
                              Region
                              AccountId
                              __typename
                            }
                          }
                          Remediation {
                            Console {
                              Steps
                            }
                          }
                        }
                        pageInfo {
                          hasNextPage
                          endCursor
                        }
                      }
                    }
                  variables:
                    first: 100
                    after: null

              finding_count:
                summary: Total finding count (health check / summary)
                value:
                  query: |
                    query {
                      Findings(first: 1) {
                        totalCount
                      }
                    }

              test_connection:
                summary: Schema introspection — validates token and lists all query types
                value:
                  query: |
                    query {
                      __schema {
                        queryType { name }
                        types {
                          name
                          kind
                          fields {
                            name
                            type {
                              name
                              kind
                              ofType { name kind }
                            }
                          }
                        }
                      }
                    }

      responses:
        '200':
          description: Successful GraphQL response
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/GraphQLResponse'
              examples:
                findings_response:
                  summary: Example findings response
                  value:
                    data:
                      Findings:
                        totalCount: 243
                        nodes:
                          - Id: "abc-123"
                            CreationTime: "2024-11-01T10:00:00Z"
                            Status: "Open"
                            Severity: "High"
                            Policy:
                              Name: "S3 bucket publicly accessible"
                              Description: "An S3 bucket is configured to allow public access"
                              Category: "Storage"
                            Resources:
                              - Name: "my-public-bucket"
                                Arn: "arn:aws:s3:::my-public-bucket"
                                Region: "us-east-1"
                                AccountId: "123456789012"
                                __typename: "AwsResource"
                            Remediation:
                              Console:
                                Steps:
                                  - "Open the S3 console"
                                  - "Select the bucket"
                                  - "Disable public access"
                        pageInfo:
                          hasNextPage: true
                          endCursor: "cursor-token-xyz"
        '401':
          description: Unauthorized — invalid or missing Bearer token
        '400':
          description: Bad request — malformed GraphQL query

components:

  securitySchemes:
    BearerAuth:
      type: http
      scheme: bearer
      description: >
        Bearer token generated in the Ermetic console under
        Settings > API Tokens. Pass as: Authorization: Bearer <token>

  schemas:

    GraphQLRequest:
      type: object
      required:
        - query
      properties:
        query:
          type: string
          description: The GraphQL query string
        variables:
          type: object
          description: Variables referenced in the query
          properties:
            first:
              type: integer
              default: 100
              description: Page size for paginated queries
            after:
              type: string
              nullable: true
              description: Cursor for the next page (null for first page)
          additionalProperties: true
        operationName:
          type: string
          description: Optional name of the operation to execute

    GraphQLResponse:
      type: object
      properties:
        data:
          type: object
          description: Query result payload
          properties:
            Findings:
              $ref: '#/components/schemas/FindingsConnection'
        errors:
          type: array
          description: Present only when the query contains errors
          items:
            $ref: '#/components/schemas/GraphQLError'

    FindingsConnection:
      type: object
      properties:
        totalCount:
          type: integer
          description: Total number of findings matching the filter
        nodes:
          type: array
          items:
            $ref: '#/components/schemas/Finding'
        pageInfo:
          $ref: '#/components/schemas/PageInfo'

    Finding:
      type: object
      properties:
        Id:
          type: string
          description: Unique finding identifier
        CreationTime:
          type: string
          format: date-time
          description: ISO 8601 timestamp when the finding was created
        Status:
          type: string
          enum: [Open, Closed, InProgress, Muted]
        Severity:
          type: string
          enum: [Critical, High, Medium, Low]
        Policy:
          $ref: '#/components/schemas/Policy'
        Resources:
          type: array
          description: Cloud resources affected by this finding
          items:
            oneOf:
              - $ref: '#/components/schemas/AwsResource'
              - $ref: '#/components/schemas/AzureResource'
              - $ref: '#/components/schemas/GcpResource'
        Remediation:
          $ref: '#/components/schemas/Remediation'

    Policy:
      type: object
      properties:
        Name:
          type: string
          description: Policy / rule name
        Description:
          type: string
          description: Full description of what the policy checks
        Category:
          type: string
          description: >
            Finding category. Known values include: Identity, Storage,
            Network, Compute, Logging, Encryption, IAM.
            Use the test_connection introspection query to confirm
            exact enum values for your tenant.

    AwsResource:
      type: object
      properties:
        __typename:
          type: string
          enum: [AwsResource]
        Name:
          type: string
        Arn:
          type: string
          description: AWS ARN of the resource
        Region:
          type: string
        AccountId:
          type: string

    AzureResource:
      type: object
      properties:
        __typename:
          type: string
          enum: [AzureResource]
        Name:
          type: string
        Id:
          type: string
          description: Azure resource ID
        Region:
          type: string
        AccountId:
          type: string
          description: Azure subscription ID

    GcpResource:
      type: object
      properties:
        __typename:
          type: string
          enum: [GcpResource]
        Name:
          type: string
        Id:
          type: string
          description: GCP resource ID
        Region:
          type: string
        AccountId:
          type: string
          description: GCP project ID

    Remediation:
      type: object
      properties:
        Console:
          type: object
          properties:
            Steps:
              type: array
              items:
                type: string
              description: Step-by-step remediation instructions

    PageInfo:
      type: object
      properties:
        hasNextPage:
          type: boolean
          description: True if more pages are available
        endCursor:
          type: string
          description: Pass this value as the "after" variable to fetch the next page

    GraphQLError:
      type: object
      properties:
        message:
          type: string
        locations:
          type: array
          items:
            type: object
            properties:
              line:
                type: integer
              column:
                type: integer
        path:
          type: array
          items:
            type: string
